{
  "name": "quiz-companion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm:server\" \"npm:dev\"",
    "db:setup": "node --env-file-if-exists=.env.local server/setup-db.js",
    "db:schema": "node --env-file-if-exists=.env.local server/setup-db.js --schema-only",
    "db:embed": "node --env-file-if-exists=.env.local server/embed-items.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
