# Copy this file to .env (git-ignored) and fill in your PostgreSQL password.
# .env.local also works and overrides .env. Neither file is ever committed.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/quiz_companion
PORT=3000

# Separate database for npm test (every table is dropped and recreated).
TEST_DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/quiz_companion_test

# Front end: override the API base URL (defaults to /api through the Vite proxy).
# VITE_API_BASE_URL=http://localhost:3000/api
